# SIGMA AI // TITAN — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- OpenRouter API Key (Primary AI provider) ---
# Sign up at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Optional: Google Gemini API Key (Fallback for native PDF processing) ---
# GEMINI_API_KEY=

# --- Optional: Model Configuration ---
# Text reasoning model (default: anthropic/claude-3.5-haiku)
# TEXT_MODEL=anthropic/claude-3.5-haiku
# Vision/multimodal model (default: google/gemini-flash-1.5)
# VISION_MODEL=google/gemini-flash-1.5

# --- Optional: Mock Mode ---
# Set to "true" to use mock responses instead of real AI calls
# USE_MOCK=false

# --- Semantic Cache ---
# SQLite cache path (default: data/sigma_cache.db)
# CACHE_DB_PATH=data/sigma_cache.db
# Cache TTL in seconds (default: 86400 = 24 hours)
# CACHE_TTL=86400

# --- Streamlit Secrets ---
# When deploying to Streamlit Cloud, set these in the Secrets section.
# OPENROUTER_API_KEY
